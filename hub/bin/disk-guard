#!/bin/zsh
# disk-guard — read-only disk-space verdict for build dispatch gating.
# L-0789 (2026-09-22, ~/.claude/hub/strategy/infra-disk-proactive-2026-09-22.md,
# scope item 1 + hub-audit amendment 1). Built because the internal disk hit
# 100% used on 2026-09-15 and 93%/15Gi again the day this ticket was opened,
# both times with no automatic signal before the emergency was already live.
#
# WHAT THIS DOES, NOTHING MORE: reads free space on /System/Volumes/Data and
# counts live build-tool processes machine-wide, prints one plain-English
# line, logs it, and exits a verdict code. It deletes nothing, kills nothing,
# and touches no file outside its own log. Safe to run any time, by anyone,
# any number of times.
#
# Thresholds (L-0942, raised from the L-0789 original): WARN < 40Gi free,
# CRIT < 15Gi free. the operator, 2026-09-23 verbatim (memory/feedback_disk_40gb_floor.md):
# "I want 40GB constantly open. Clear out more than that and 40GB should be
# the warning sign to clear more." The census that opened L-0942 found the
# machine at 22Gi free -- already below this floor -- and the old 30Gi
# threshold would have called that merely OK. CRIT (15Gi) is unchanged; it
# stays the hard build block regardless of the floor. WARN also still lines
# up with the orphan-reaper alert thresholds this ticket's item 2 extends,
# so the two surfaces never disagree about what "CRIT" means.
#
# Exit codes: 0 = OK (dispatch freely), 1 = WARN (serialize — the caller
# should hold new builds to one at a time), 2 = CRIT (hard block — no new
# build dispatches). The build-process count is reported as data for the
# caller to use; this script does not itself change its exit code based on
# concurrency, only on free space.
#
# BUILD_COUNT is computed with a shell `case`, not a `grep` on the ps output
# -- a grep whose own pattern text contains "npm|next|..." would match its
# OWN process line in the same ps snapshot and over-count by one. This is the
# same pitfall build-cache-sweep.sh's worktree_busy() already avoids the same
# way; reused here on purpose.
#
# DISK_GUARD_VOLUME lets a test point this at a different df target; unset
# (the default) always reads the real internal volume.
#
# DISK_GUARD_FREE_GI_OVERRIDE (L-0942, test-only): when set, skips the real
# `df -g` read entirely and uses this value as FREE_GI instead, so a fixture
# can assert the exact threshold boundary (e.g. "35Gi free -> WARN") without
# needing a real volume of that exact size. Unset (the default, always true
# in production) always reads the real filesystem via df; this override is
# never consulted unless a caller deliberately sets it.
set -u

VOLUME=${DISK_GUARD_VOLUME:-/System/Volumes/Data}
LOG=${DISK_GUARD_LOG:-$HOME/.claude/hub/disk-guard.log}
mkdir -p "$(dirname "$LOG")"

if [[ -n "${DISK_GUARD_FREE_GI_OVERRIDE:-}" ]]; then
  FREE_GI=$DISK_GUARD_FREE_GI_OVERRIDE
else
  FREE_GI=$(df -g "$VOLUME" 2>/dev/null | awk 'NR==2{print $4}')
fi
case "$FREE_GI" in
  <->) ;;  # one or more digits, good
  *)
    print -r -- "disk-guard: could not read free space on $VOLUME — treating as CRIT (fail safe, never fail open)"
    print -r -- "$(date +%FT%T) disk-guard: df failed on $VOLUME — CRIT (fail-safe)" >> "$LOG"
    exit 2
    ;;
esac

BUILD_COUNT=0
while read -r pid cmd; do
  [[ -z "$pid" ]] && continue
  case "$cmd" in
    *npm\ *|*npx\ *|*next\ *|*yarn\ *|*pnpm\ *|*vite\ *|*webpack\ *|*turbo\ *)
      # Item 19 (2026-10-05): count only builds whose cwd is on the ROOT disk. A build running
      # from /Volumes/* (the USB build drive) does not fill root, so it is not counted.
      # cwd unreadable -> counted (fail safe).
      _cwd=$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)
      case "$_cwd" in /Volumes/*) ;; *) BUILD_COUNT=$((BUILD_COUNT + 1)) ;; esac ;;
  esac
done < <(ps -axo pid=,command=)

# L-1775 item 2: CRIT floor is 15Gi unless the caller (ws-build-slot / guarded-build, via
# deploy-floor-lib.zsh) passes a lower DISK_GUARD_CRIT_GI for a proven deploy-only lane. Non-numeric
# or > 15 values are ignored (the floor can only be lowered by a validated caller, never raised).
CRIT_GI=${DISK_GUARD_CRIT_GI:-15}
[[ "$CRIT_GI" == <1-15> && "$CRIT_GI" != 0* ]] || CRIT_GI=15  # bounded pattern, no arithmetic on raw input
if (( FREE_GI < CRIT_GI )); then
  VERDICT="CRIT"; CODE=2; NOTE="builds blocked"
elif (( FREE_GI < 40 )); then
  VERDICT="WARN"; CODE=1; NOTE="serialize — only 1 concurrent build"
else
  VERDICT="OK"; CODE=0; NOTE="builds allowed"
fi

# L-1682: report the USB build drive's free space next to root. INFORMATION ONLY -- the verdict
# and exit code above stay root-disk-only. DISK_GUARD_USB_VOLUME overrides (tests).
# Default is empty = no external drive reported. Set DISK_GUARD_USB_VOLUME=/Volumes/YourDrive to opt in.
USB_VOL=${DISK_GUARD_USB_VOLUME:-}
USB_NOTE="no external build drive configured"
if [[ -z "$USB_VOL" ]]; then
  :
elif [[ -d "$USB_VOL" ]]; then
  USB_GI=$(df -g "$USB_VOL" 2>/dev/null | awk 'NR==2{print $4}')
  case "$USB_GI" in
    <->) USB_NOTE="USB build drive: ${USB_GI}Gi free" ;;
    *)   USB_NOTE="USB build drive: free space unreadable" ;;
  esac
else
  USB_NOTE="USB build drive: NOT MOUNTED (builds fall back to root disk)"
fi

# L-1589: INFORMATION ONLY (verdict and exit code unchanged). Name every ROOT-disk WS worktree whose
# .next/out build output exceeds 2G (DISK_GUARD_BIG_KB) with no live process whose cwd is inside it,
# so the alarm line says what build-cache-sweep.sh will reclaim. The du walk is slow (~30s per 3 dirs
# under load), so it runs in the BACKGROUND into a cache file refreshed every 30 min; this line only
# reads the cache (DISK_GUARD_BIG_SYNC=1 runs it inline, tests). DISK_GUARD_WT_ROOT overrides the root.
WT_ROOT=${DISK_GUARD_WT_ROOT:-$HOME/projects}
BIG_KB=${DISK_GUARD_BIG_KB:-2097152}
BIG_CACHE=${DISK_GUARD_BIG_CACHE:-$HOME/.claude/hub/state/disk-guard-bigwt.txt}
_big_scan() {
  local _out="" _wt _kb _c _live
  _live=$(lsof -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
  for _wt in "$WT_ROOT"/*-wt/*(/N) "$WT_ROOT"/*-wt(/N); do
    [[ -f "$_wt/.git" ]] || continue
    _kb=0
    for _c in .next out site/.next site/out; do
      [[ -d "$_wt/$_c" ]] && _kb=$(( _kb + $(du -sk "$_wt/$_c" 2>/dev/null | awk '{print $1+0}') ))
    done
    (( _kb > BIG_KB )) || continue
    print -r -- "$_live" | grep -qF -- "$_wt" && continue   # live owner -> not an orphan
    _out="${_out} ${_wt:t}($(( _kb / 1048576 ))G)"
  done
  mkdir -p "${BIG_CACHE:h}"
  print -r -- "$_out" > "$BIG_CACHE.tmp.$$" && mv "$BIG_CACHE.tmp.$$" "$BIG_CACHE"
}
if [[ "${DISK_GUARD_BIG_SYNC:-0}" == 1 ]]; then
  _big_scan
elif [[ ! -f "$BIG_CACHE" || -n "$(find "$BIG_CACHE" -mmin +30 2>/dev/null)" ]]; then
  ( _big_scan ) >/dev/null 2>&1 &!
fi
BIG_WT=""
[[ -f "$BIG_CACHE" ]] && BIG_WT=$(<"$BIG_CACHE")
BIG_NOTE=""
[[ -n "${BIG_WT// /}" ]] && BIG_NOTE=" — BIG-WT (no live owner, >2G build output, sweep will reclaim):${BIG_WT}"

LINE="disk-guard: ${FREE_GI}Gi free — ${VERDICT} (${NOTE}) — ${USB_NOTE} — live build processes: ${BUILD_COUNT}${BIG_NOTE}"
print -r -- "$LINE"
print -r -- "$(date +%FT%T) $LINE" >> "$LOG"
exit $CODE
