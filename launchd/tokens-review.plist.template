<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL_PREFIX@.tokens-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>@DEST@/routines/tokens-review.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>5</integer>
    <key>Hour</key><integer>16</integer>
    <key>Minute</key><integer>3</integer>
  </dict>
  <key>StandardOutPath</key><string>/tmp/tokens-review.out</string>
  <key>StandardErrorPath</key><string>/tmp/tokens-review.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
