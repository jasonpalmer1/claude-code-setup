<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL_PREFIX@.weekly-process-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/nice</string>
    <string>-n</string>
    <string>10</string>
    <string>/usr/bin/python3</string>
    <string>@DEST@/hub/bin/weekly-process-review</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/tmp/weekly-process-review.out</string>
  <key>StandardErrorPath</key><string>/tmp/weekly-process-review.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
