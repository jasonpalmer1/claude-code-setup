<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL_PREFIX@.disk-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>@DEST@/hub/bin/disk-guard</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>/tmp/disk-guard.out</string>
  <key>StandardErrorPath</key><string>/tmp/disk-guard.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
